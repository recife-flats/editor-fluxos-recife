            {
              "id": "a2",
              "name": "phone_normalized",
              "value": "=={{ ($json.body.sender.phone_number || '').replace(/\\D/g, '').length === 12 && ($json.body.sender.phone_number || '').replace(/\\D/g, '').startsWith('55') ? ($json.body.sender.phone_number || '').replace(/\\D/g, '').substring(0,4) + '9' + ($json.body.sender.phone_number || '').replace(/\\D/g, '').substring(4) : ($json.body.sender.phone_number || '').replace(/\\D/g, '') }}",
